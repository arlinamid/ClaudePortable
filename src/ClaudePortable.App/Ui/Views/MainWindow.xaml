<Window x:Class="ClaudePortable.App.Ui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ClaudePortable.App.Ui.Converters"
        xmlns:loc="clr-namespace:ClaudePortable.App.Localization"
        xmlns:views="clr-namespace:ClaudePortable.App.Ui.Views"
        Title="AgentPortable"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1120" Height="720"
        MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#262624"
        Foreground="#FFFFFF"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">
    <Window.Resources>
        <conv:ManagedByToBrushConverter x:Key="ManagedByToBrush" />
        <conv:StringToVisibleConverter x:Key="StringToVisible" />
        <conv:BoolToYesNoConverter x:Key="BoolToYesNo" />
    </Window.Resources>
    <DockPanel Background="#262624">

        <!-- Status bar at the very bottom -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="StatusText" Text="{Binding Status}"
                           AutomationProperties.LiveSetting="Polite" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ProgressMessage}" Foreground="#D6D3C9" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <ProgressBar Width="220" Height="6"
                                 AutomationProperties.Name="{Binding ProgressMessage}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Minimum="0" Maximum="1"
                                 IsIndeterminate="{Binding ProgressIsIndeterminate}"
                                 Foreground="#D97757" Background="#33322F" BorderThickness="0" />
                    <Button Content="{loc:Loc Common_Cancel}"
                            Command="{Binding CancelBackupCommand}"
                            Visibility="{Binding IsBackupRunning, Converter={StaticResource BoolToVisible}}"
                            Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="240" Background="{DynamicResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="20,24,20,0">
                        <Rectangle Width="22" Height="22" RadiusX="5" RadiusY="5" Fill="{DynamicResource AccentBrush}" />
                        <TextBlock Text="AgentPortable" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{DynamicResource SidebarVersion}" Text="{Binding AppVersionLabel}" />
                </StackPanel>

                <!-- Nav -->
                <ListBox x:Name="Nav" Grid.Row="1"
                         AutomationProperties.Name="{loc:Loc A11y_Navigation}"
                         Style="{DynamicResource SidebarNav}"
                         ItemContainerStyle="{DynamicResource NavItem}"
                         SelectedIndex="0">
                    <ListBoxItem AutomationProperties.Name="{loc:Loc Nav_Status}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource NavGlyph}" Text="&#xE9D9;" />
                            <TextBlock Style="{DynamicResource NavLabel}" Text="{loc:Loc Nav_Status}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{loc:Loc Nav_Targets}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource NavGlyph}" Text="&#xE8B7;" />
                            <TextBlock Style="{DynamicResource NavLabel}" Text="{loc:Loc Nav_Targets}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{loc:Loc Nav_Discovery}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource NavGlyph}" Text="&#xE721;" />
                            <TextBlock Style="{DynamicResource NavLabel}" Text="{loc:Loc Nav_Discovery}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{loc:Loc Nav_Restore}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource NavGlyph}" Text="&#xE7A7;" />
                            <TextBlock Style="{DynamicResource NavLabel}" Text="{loc:Loc Nav_Restore}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{loc:Loc Nav_Logs}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource NavGlyph}" Text="&#xE9F9;" />
                            <TextBlock Style="{DynamicResource NavLabel}" Text="{loc:Loc Nav_Logs}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="{loc:Loc Nav_Schedule}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource NavGlyph}" Text="&#xE787;" />
                            <TextBlock Style="{DynamicResource NavLabel}" Text="{loc:Loc Nav_Schedule}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Footer: language switch + always-visible primary action -->
                <StackPanel Grid.Row="2" Margin="16,8,16,20">
                    <ComboBox x:Name="LanguageBox"
                              AutomationProperties.Name="{loc:Loc A11y_Language}"
                              Style="{DynamicResource DarkCombo}"
                              Margin="0,0,0,10"
                              SelectionChanged="OnLanguageSelectionChanged">
                        <ComboBoxItem Tag="en" Content="English" />
                        <ComboBoxItem Tag="hu" Content="Magyar" />
                    </ComboBox>
                    <Button Content="{loc:Loc Sidebar_BackupNow}"
                            Style="{DynamicResource PrimaryButton}"
                            Command="{Binding BackupNowCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Subtle divider between sidebar and content -->
        <Border DockPanel.Dock="Left" Width="1" Background="{DynamicResource BorderBrush}" />

        <!-- Main content area, driven by sidebar -->
        <views:PageHost Style="{DynamicResource HiddenTabs}" SelectedIndex="{Binding ElementName=Nav, Path=SelectedIndex}">

            <!-- 1. Status / Dashboard -->
            <TabItem>
                <Grid Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource H1}" Text="{loc:Loc Nav_Status}" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Status_Caption}" Margin="0,0,0,20" Grid.Row="1" />

                    <!-- Summary cards -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,20">
                        <Border Style="{DynamicResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Status_CardBackups}" />
                                <TextBlock Text="{Binding Backups.Count}" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Style="{DynamicResource Muted}" Text="{loc:Loc Status_CardBackupsSub}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Status_CardTargets}" />
                                <TextBlock Text="{Binding Targets.Count}" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Style="{DynamicResource Muted}" Text="{loc:Loc Status_CardTargetsSub}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Status_CardDiscovered}" />
                                <TextBlock Text="{Binding ClaudePaths.Count}" FontSize="32" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Style="{DynamicResource Muted}" Text="{loc:Loc Status_CardDiscoveredSub}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- What to back up: used by Backup now and the scheduled task -->
                    <Border Style="{DynamicResource Card}" Grid.Row="3" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Status_WhatToBackUp}" />
                            <StackPanel Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding BackupGroups}" AutomationProperties.Name="{loc:Loc Status_WhatToBackUp}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      Content="{Binding Label}"
                                                      ToolTip="{Binding Hint}"
                                                      AutomationProperties.HelpText="{Binding Hint}"
                                                      Foreground="#D6D3C9"
                                                      Margin="0,4,24,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Style="{DynamicResource Muted}" Text="{loc:Loc Status_WhatToBackUpHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{DynamicResource H2}" Text="{loc:Loc Status_RecentBackups}" VerticalAlignment="Center" />
                        <Button Content="{loc:Loc Common_Refresh}"
                                Command="{Binding RefreshCommand}"
                                HorizontalAlignment="Right" Margin="16,0,0,8" />
                    </StackPanel>

                    <DataGrid Grid.Row="5"
                              AutomationProperties.Name="{loc:Loc Status_RecentBackups}"
                              ItemsSource="{Binding Backups}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc Grid_Tier}" Binding="{Binding Manifest.RetentionTier}" Width="Auto" />
                            <DataGridTextColumn Header="{loc:Loc Grid_Created}" Binding="{Binding Manifest.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto" />
                            <DataGridTextColumn Header="{loc:Loc Grid_Hostname}" Binding="{Binding Manifest.Hostname}" Width="Auto" />
                            <DataGridTextColumn Header="{loc:Loc Grid_Contents}" Binding="{Binding ContentsLabel}" Width="Auto" />
                            <DataGridTextColumn Header="{loc:Loc Grid_Size}" Binding="{Binding SizeBytes, StringFormat=N0}" Width="Auto" />
                            <DataGridTextColumn Header="{loc:Loc Grid_File}" Binding="{Binding FileName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 2. Targets -->
            <TabItem>
                <Grid Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource H1}" Text="{loc:Loc Nav_Targets}" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Targets_Caption}" Margin="0,0,0,20" Grid.Row="1" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="{loc:Loc Targets_AddFolder}"
                                Style="{DynamicResource PrimaryButton}"
                                Command="{Binding AddTargetCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Targets_SetActive}"
                                Command="{Binding SetActiveTargetCommand}"
                                ToolTip="{loc:Loc Targets_SetActiveTooltip}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Targets_RemoveSelected}"
                                Command="{Binding RemoveTargetCommand}" />
                        <TextBlock Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Run Text="{loc:Loc Targets_ActiveLabel}" FontWeight="SemiBold" />
                            <Run Text="{Binding ActiveTargetPath, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Border Style="{DynamicResource Card}" Padding="0" Grid.Row="3">
                        <DataGrid AutomationProperties.Name="{loc:Loc Nav_Targets}" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Grid_Path}" Binding="{Binding Path}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3. Discovery -->
            <TabItem>
                <Grid Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource H1}" Text="{loc:Loc Nav_Discovery}" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Discovery_Caption}" Margin="0,0,0,20" Grid.Row="1" TextWrapping="Wrap" />

                    <TextBlock Style="{DynamicResource H2}" Text="{loc:Loc Discovery_ClaudePaths}" Grid.Row="2" Margin="0,0,0,8" />
                    <Border Style="{DynamicResource Card}" Padding="0" Grid.Row="3">
                        <DataGrid AutomationProperties.Name="{loc:Loc Discovery_ClaudePaths}" ItemsSource="{Binding ClaudePaths}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Grid_Source}" Binding="{Binding Label}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Key}" Binding="{Binding Key}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Path}" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Exists}" Binding="{Binding Exists, Converter={StaticResource BoolToYesNo}}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <TextBlock Style="{DynamicResource H2}" Text="{loc:Loc Discovery_SyncClients}" Grid.Row="4" Margin="0,20,0,8" />
                    <Border Style="{DynamicResource Card}" Padding="0" Grid.Row="5">
                        <DataGrid AutomationProperties.Name="{loc:Loc Discovery_SyncClients}" ItemsSource="{Binding SyncClients}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Grid_Name}" Binding="{Binding Name}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Path}" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Avail}" Binding="{Binding IsAvailable, Converter={StaticResource BoolToYesNo}}" Width="Auto" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 4. Restore -->
            <TabItem>
                <Grid Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource H1}" Text="{loc:Loc Nav_Restore}" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Restore_Caption}" TextWrapping="Wrap" Margin="0,0,0,20" Grid.Row="1" />

                    <TextBlock Style="{DynamicResource H2}" Text="{loc:Loc Restore_AvailableSnapshots}" Grid.Row="2" />

                    <Border Style="{DynamicResource Card}" Padding="0" Grid.Row="3">
                        <DataGrid AutomationProperties.Name="{loc:Loc Restore_AvailableSnapshots}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc Grid_Status}" Binding="{Binding StatusLabel}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Tier}" Binding="{Binding Manifest.RetentionTier}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Created}" Binding="{Binding Manifest.CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Hostname}" Binding="{Binding Manifest.Hostname}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Contents}" Binding="{Binding ContentsLabel}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_File}" Binding="{Binding FileName}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Style="{DynamicResource Card}" Grid.Row="4" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Restore_WhatToRestore}" />
                            <StackPanel Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding RestoreGroups}" AutomationProperties.Name="{loc:Loc Restore_WhatToRestore}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}"
                                                      Content="{Binding Label}"
                                                      ToolTip="{Binding Hint}"
                                                      AutomationProperties.HelpText="{Binding Hint}"
                                                      Foreground="#D6D3C9"
                                                      Margin="0,4,24,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Style="{DynamicResource Muted}" Text="{loc:Loc Restore_WhatToRestoreHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Grid.Row="5">
                        <Button Content="{loc:Loc Restore_RestoreSelected}"
                                Style="{DynamicResource PrimaryButton}"
                                Command="{Binding RestoreCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{loc:Loc Restore_RestoreFromFile}"
                                Command="{Binding RestoreFromFileCommand}" />
                        <Button Content="{loc:Loc Restore_OpenChecklist}"
                                Command="{Binding OpenChecklistCommand}"
                                Margin="8,0,0,0"
                                Visibility="{Binding PostRestoreChecklistPath, Converter={StaticResource StringToVisible}}" />
                    </StackPanel>

                    <Expander Grid.Row="6" Margin="0,16,0,0"
                              Foreground="#D6D3C9"
                              Header="{loc:Loc Restore_AdvancedOptions}"
                              FontSize="13"
                              FontWeight="SemiBold">
                        <Border Style="{DynamicResource Card}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Restore_AdvancedCaption}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                <TextBlock Text="{loc:Loc Restore_TargetUserProfile}" Margin="0,0,0,4" FontWeight="SemiBold" Foreground="#D6D3C9" />
                                <DockPanel Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Content="{loc:Loc Common_Browse}"
                                            Command="{Binding PickTargetProfileCommand}"
                                            Margin="8,0,0,0" />
                                    <TextBox Text="{Binding TargetUserProfileOverride, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Loc Restore_TargetUserProfile}"
                                             Style="{DynamicResource DarkTextBox}"
                                             FontFamily="{DynamicResource MonoFont}" />
                                </DockPanel>

                                <CheckBox IsChecked="{Binding IgnoreVersionMismatch}"
                                          Foreground="#D6D3C9"
                                          Margin="0,0,0,8">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{loc:Loc Restore_IgnoreVersionMismatch}" />
                                        <Run Text="{loc:Loc Restore_IgnoreVersionMismatchHint}" Foreground="#B5B2A8" FontSize="12" FontStyle="Italic" />
                                    </TextBlock>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>
            </TabItem>

            <!-- 5. Logs -->
            <TabItem>
                <Grid Margin="32,24,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource H1}" Text="{loc:Loc Nav_Logs}" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Logs_Caption}" Margin="0,0,0,20" Grid.Row="1" />

                    <Border Style="{DynamicResource Card}" Grid.Row="2">
                        <ListBox AutomationProperties.Name="{loc:Loc Nav_Logs}" ItemsSource="{Binding LogEntries}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- 6. Schedule -->
            <TabItem>
                <Grid Margin="32,24,32,24" DataContext="{Binding ScheduledTasks}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{DynamicResource H1}" Text="{loc:Loc Nav_Schedule}" />
                    <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Schedule_Caption}" TextWrapping="Wrap" Margin="0,0,0,20" Grid.Row="1" />

                    <!-- Auto-backup setup: GUI equivalent of `schedule install` -->
                    <Border Style="{DynamicResource Card}" Grid.Row="2" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource H2}" Text="{loc:Loc Schedule_AutoBackupTitle}" Margin="0,0,0,4" />
                            <TextBlock Style="{DynamicResource Caption}" Text="{loc:Loc Schedule_AutoBackupCaption}" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="{loc:Loc Schedule_AtLabel}" Foreground="#D6D3C9" Margin="0,0,0,4" />
                                    <TextBox Style="{DynamicResource DarkTextBox}"
                                             Text="{Binding InstallTime, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Loc Schedule_AtLabel}"
                                             Width="90"
                                             FontFamily="{DynamicResource MonoFont}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,8">
                                    <TextBlock Text="{loc:Loc Schedule_TaskNameLabel}" Foreground="#D6D3C9" Margin="0,0,0,4" />
                                    <TextBox Style="{DynamicResource DarkTextBox}"
                                             Text="{Binding InstallTaskName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{loc:Loc Schedule_TaskNameLabel}"
                                             Width="220"
                                             FontFamily="{DynamicResource MonoFont}" />
                                </StackPanel>
                                <Button Content="{loc:Loc Schedule_InstallTask}"
                                        Style="{DynamicResource PrimaryButton}"
                                        Command="{Binding InstallBackupTaskCommand}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,8,8" />
                                <Button Content="{loc:Loc Schedule_RemoveTask}"
                                        Command="{Binding RemoveBackupTaskCommand}"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,16,8" />
                                <TextBlock Style="{DynamicResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,14" TextTrimming="CharacterEllipsis">
                                    <Run Text="{loc:Loc Targets_ActiveLabel}" FontWeight="SemiBold" />
                                    <Run Text="{Binding DataContext.ActiveTargetPath, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
                                </TextBlock>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="3" Margin="0,0,0,12" LastChildFill="True">
                        <Button DockPanel.Dock="Left" Content="{loc:Loc Common_Refresh}"
                                Style="{DynamicResource PrimaryButton}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,0,12,0" />
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                            <RadioButton Content="{loc:Loc Schedule_FilterRelevant}" GroupName="ScheduleFilter"
                                         IsChecked="{Binding IsFilterRelevant, Mode=TwoWay}"
                                         Margin="0,0,12,0" Foreground="#D6D3C9" VerticalAlignment="Center" />
                            <RadioButton Content="{loc:Loc Schedule_FilterManaged}" GroupName="ScheduleFilter"
                                         IsChecked="{Binding IsFilterManaged, Mode=TwoWay}"
                                         Margin="0,0,12,0" Foreground="#D6D3C9" VerticalAlignment="Center" />
                            <RadioButton Content="{loc:Loc Schedule_FilterAll}" GroupName="ScheduleFilter"
                                         IsChecked="{Binding IsFilterAll, Mode=TwoWay}"
                                         Foreground="#D6D3C9" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="ScheduleStatusText" Style="{DynamicResource Muted}" Text="{Binding StatusLine}"
                                   AutomationProperties.LiveSetting="Polite"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <Border Style="{DynamicResource Card}" Padding="0" Grid.Row="4">
                        <DataGrid AutomationProperties.Name="{loc:Loc A11y_ScheduledTasks}" ItemsSource="{Binding Tasks}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  RowHeight="40"
                                  FrozenColumnCount="2"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="32" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="10" Height="10" CornerRadius="5"
                                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Background="{Binding ManagedBy, Converter={StaticResource ManagedByToBrush}}"
                                                    ToolTip="{Binding ManagedByLabel}"
                                                    AutomationProperties.Name="{Binding ManagedByLabel}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Compact ⋮ menu frozen on the left so remove/modify stay reachable. -->
                                <DataGridTemplateColumn Header="" Width="48" CanUserResize="False" CanUserReorder="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="⋮"
                                                    ToolTip="{loc:Loc Schedule_RowActions}"
                                                    AutomationProperties.Name="{loc:Loc Schedule_RowActions}"
                                                    Padding="8,2"
                                                    FontSize="16"
                                                    FontWeight="Bold"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Click="OnScheduleRowActionsClick">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="{loc:Loc Schedule_Run}" Command="{Binding RunNowCommand}" />
                                                        <MenuItem Header="{loc:Loc Schedule_Disable}" Command="{Binding DisableCommand}" />
                                                        <MenuItem Header="{loc:Loc Schedule_Enable}" Command="{Binding EnableCommand}" />
                                                        <MenuItem Header="{loc:Loc Schedule_Xml}" Command="{Binding ViewXmlCommand}" />
                                                        <Separator />
                                                        <MenuItem Header="{loc:Loc Schedule_Delete}" Command="{Binding DeleteCommand}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Loc Grid_Name}" Binding="{Binding FullName}" Width="*" MinWidth="120" />
                                <DataGridTextColumn Header="{loc:Loc Grid_ManagedBy}" Binding="{Binding ManagedByLabel}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_State}" Binding="{Binding State}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Schedule}" Binding="{Binding TriggerSummary}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Next}" Binding="{Binding NextRunDisplay}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Last}" Binding="{Binding LastRunDisplay}" Width="Auto" />
                                <DataGridTextColumn Header="{loc:Loc Grid_Action}" Binding="{Binding ActionDisplay}" Width="*" MinWidth="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </views:PageHost>

    </DockPanel>
</Window>
